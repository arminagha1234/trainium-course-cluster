# Cluster-level slurm.conf snippet appended by ParallelCluster via
# `SlurmSettings.CustomSlurmSettingsIncludeFile`.
#
# This file is the TEMPLATE, but it no longer carries any envsubst variables.
# `scripts/deploy.sh` still renders it (a no-op `envsubst` / copy) and uploads
# the result to s3://<staging>/slurm/neuroncore-gres.conf before invoking
# `pcluster create-cluster`.
#
# Required at render time:
#   (none) — this template has NO envsubst variables.
#
# Why there is NO per-node `Gres=neuroncore:N` / `NodeName=...` line here:
#   ParallelCluster GENERATES its own `NodeName=<queue>-st-<resource>-N ...`
#   line for each static node in
#   /opt/slurm/etc/pcluster/slurm_parallelcluster_<queue>_partition.conf.
#   Emitting our own `NodeName=<pattern> Gres=neuroncore:N` here created a SECOND
#   NodeName line for the same node -> `fatal: Duplicated NodeHostName` ->
#   slurmctld dies -> cluster CREATE_FAILED. PC also DENY-LISTS `Gres`,
#   `NodeName`, and `Features` at the compute-resource level for
#   CustomSlurmSettings, so the per-node gres cannot be attached through this
#   include at all. Instead, the per-node `Gres=neuroncore:N` is appended to PC's
#   OWN generated NodeName line by bootstrap/head-node-setup.sh (the controller)
#   and bootstrap/compute-node-setup.sh (slurmd), which then reload. gres.conf
#   (the per-device mapping) still lives on each compute node and is written by
#   the compute bootstrap, NOT here. slurm.conf and gres.conf must agree, or
#   slurmd will refuse to register.

# Declare the neuroncore GRES type cluster-wide, alongside gpu. PC's base
# slurm.conf sets `GresTypes=gpu`; because this include is appended LAST, its
# GresTypes wins (last occurrence in slurm.conf), so we list BOTH to preserve
# gpu and add neuroncore.
GresTypes=gpu,neuroncore

# -----------------------------------------------------------------------------
# Per-student limit enforcement (design divergence D5; Requirements 18.1, 18.2,
# 18.3).
#
# ParallelCluster appends this include at the END of the slurm.conf it
# generates, so these directives take precedence (last occurrence wins in
# slurm.conf). They convert the per-student QoS / associations that
# head-node-setup.sh creates via `sacctmgr` (MaxWall, MaxJobsPerUser,
# MaxTRESPerUser=gres/neuroncore, GrpTRESMins=gres/neuroncore) from advisory
# bookkeeping into *enforced* gates.
#
# Prerequisite: Slurm accounting (slurmdbd) must be active. That is wired via
# `SlurmSettings.Database` in infra/pcluster-config.yaml. Without slurmdbd,
# `sacctmgr` cannot store associations/QoS and both directives below are inert.
#
# Deny-list note: when `Database` is configured, ParallelCluster owns and
# deny-lists AccountingStorageType/Host/Port/User and JobAcctGatherType for
# custom Slurm settings — do NOT set those here. AccountingStorageEnforce and
# AccountingStorageTRES are NOT PC-managed and default to "no enforcement" /
# base-TRES-only, so they must be set explicitly. PC performs no validation on
# CustomSlurmSettingsIncludeFile content, so these are appended verbatim and it
# is our responsibility to keep them valid for the target Slurm version.
# (Behavior is PC/Slurm-version-specific; documented, not verified here.)

# Enforce association + QoS limits on submission. `limits` and `qos` both imply
# `associations`. The Slurm default is no enforcement, which is why the prior
# configuration recorded usage (at best) but never gated submissions.
AccountingStorageEnforce=associations,limits,qos

# Track NeuronCores as a GRES TRES so the per-student core cap
# (MaxTRESPerUser=gres/neuroncore) and core-hours budget
# (GrpTRESMins=gres/neuroncore) can be evaluated. Base TRES (cpu, mem, node,
# billing, ...) are tracked automatically and need not be listed here. Requires
# the `GresTypes=neuroncore` declaration above.
AccountingStorageTRES=gres/neuroncore
